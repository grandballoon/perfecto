#!/usr/bin/env python
# Builds the kernel and its Godot stream into one library in ../project/bin.
# The kernel's sources are compiled from where they live, so the spike and
# the phone sound the same.

env = SConscript("godot-cpp/SConstruct")

kernel = "../../../Perfecto/Sources/PerfectoKernel"
env.Append(CPPPATH=["src/", kernel, kernel + "/include"])
# The kernel's objects are built here, not beside its sources.
sources = Glob("src/*.cpp") + [
    env.SharedObject("build/kernel/" + source.name.replace(".cpp", ""), source)
    for source in Glob(kernel + "/*.cpp")
]

name = "../project/bin/libperfecto{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
Default(env.SharedLibrary(name, source=sources))
