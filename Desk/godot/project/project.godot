; Engine configuration file.

config_version=5

[application]

config/name="Perfecto Desk"
run/main_scene="res://desk/desk.tscn"
config/features=PackedStringArray("4.7")
; The desk is stepped every frame, so a frame is how late a press can be
; read: 4 ms, as the Mac desk's 250 Hz.
run/max_fps=250

[audio]

driver/mix_rate=48000
driver/mix_buffer_frames=128
driver/output_latency=3

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/vsync/vsync_mode=0
