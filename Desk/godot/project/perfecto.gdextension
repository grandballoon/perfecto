[configuration]

entry_symbol = "perfecto_library_init"
compatibility_minimum = "4.5"

[libraries]

macos.debug = "res://bin/libperfecto.macos.template_release.arm64.dylib"
macos.release = "res://bin/libperfecto.macos.template_release.arm64.dylib"
linux.debug.x86_64 = "res://bin/libperfecto.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://bin/libperfecto.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libperfecto.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://bin/libperfecto.windows.template_release.x86_64.dll"
